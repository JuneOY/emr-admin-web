{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmit": true
  },
  "include": [
    "electron/**/*.ts",
    "backend/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "build/**/*.ts",
    "*.config.ts"
  ]
}
